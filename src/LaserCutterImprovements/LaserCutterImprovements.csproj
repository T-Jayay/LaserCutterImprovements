<Project Sdk="Microsoft.NET.Sdk">
  <!-- LaserCutterImprovements: changes to the Engineer's Laser Cutter primary (a range indicator, a smaller turret
       hitbox for your own beam, healing and damaging with one beam, and a beam that ends where it hits).
       Everything else comes from Directory.Build.props and Directory.Build.targets in the repo root. -->
  <ItemGroup>
    <!-- The IL./On. hook types. Compile only: HookGenPatcher (a manifest dependency) generates MMHOOK_RoR2.dll on the
         player's machine. The package targets .NET Framework, which the game's runtime is compatible with (NU1701). -->
    <PackageReference Include="MMHOOK.RoR2" Version="2026.10.8" IncludeAssets="compile" NoWarn="NU1701" />
  </ItemGroup>
</Project>
